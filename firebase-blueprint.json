        "createdAt": { "type": "string" }
      },
      "required": ["id", "beneficiaryUserId", "commissionAmountINR", "status"]
    },
    "referralWithdrawals": {
      "title": "Referral Withdrawals",
      "description": "Payout requests for referral earnings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "amount": { "type": "number" },
        "upiId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "tickets": {
      "title": "Support Tickets",
      "description": "Customer support tickets and responses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "subject", "status"]
    },
    "settings": {
      "title": "Admin Settings",
      "description": "Global application configuration settings",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "upiId": { "type": "string" },
        "merchantId": { "type": "string" },
        "autoVerifyMerchant": { "type": "boolean" },
        "notice": { "type": "string" }
      }
    }
