{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Registered panel users and account balances",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "balance": { "type": "number" },
        "totalSpent": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredByUserId": { "type": "string" },
        "referralBalance": { "type": "number" },
        "totalReferralEarnings": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "email"]
    },
    "orders": {
      "title": "Orders",
      "description": "SMM service orders placed by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "serviceId": { "type": "string" },
        "quantity": { "type": "number" },
        "charge": { "type": "number" },
        "link": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "serviceId", "quantity", "charge", "status"]
    },
    "depositRequests": {
      "title": "Deposit Requests",
      "description": "Payment and fund deposit requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "status"]
    },
    "referralCommissions": {
      "title": "Referral Commissions",
      "description": "Earned referral commissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "beneficiaryUserId": { "type": "string" },
        "sourceUserId": { "type": "string" },
        "level": { "type": "number" },
